<h1>Home Page</h1>
<% if (blogs.length) { %>
    <% blogs.forEach(element => { %>
        <div class="blog-card">
            <a href="/blog/<%= element._id %>">
                <h2><%= element.title %></h2>
            </a>
            <p><%= element.page %></p>
        </div>
    <% }); %>
<% } else { %>
    <h1>No blogs found</h1>
<% } %>

<script>
    // Extract the success message from the URL
    const urlParams = new URLSearchParams(window.location.search);
    const successMessage = urlParams.get('success');
    if (successMessage) {
        alert(successMessage);
    }
</script>