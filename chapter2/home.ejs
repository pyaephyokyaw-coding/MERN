<h1>Home page</h1>
<% if(blogs.length) { %>
    <% blogs.forEach(element=> { %>
        <div class="blog-card">
            <h1>
                <%= element.title %>
            </h1>
            <p>
                <%= element.page %>
            </p>
            <% }); %>
                <% } else { %>
                    <h1>No blogs found</h1>
        </div>
        <% } %>