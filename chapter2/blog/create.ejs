<h1>Blog <%= typeof blog !== "undefined" ? "Update" : "Create" %></h1>

<form action="/blog-create/<%= typeof blog !== "undefined" ? blog.id : 0 %>" method="post">
    <div class="form-group">
        <label for="title">Title</label>
        <input name="title" type="text" id="title" value="<%= typeof blog !== "undefined" ? blog.title : '' %>">
    </div>
    
    <div class="form-group">
        <label for="intro">Intro</label>
        <input name="intro" type="text" id="intro" value="<%= typeof blog !== "undefined" ? blog.intro : '' %>">
    </div>
    
    <div class="form-group">
        <label for="body">Body</label>
        <textarea name="body" id="body" rows="5" cols="50"><%= typeof blog !== "undefined" ? blog.body : '' %></textarea>
    </div>
    
    <div class="form-group">
        <button type="submit" class="create-btn"><%= typeof blog !== "undefined" ? "Update" : "Create" %></button>
    </div>
</form>
